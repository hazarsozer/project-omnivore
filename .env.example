# ============================================================
# Omnivore — environment configuration
# Copy this file to .env and fill in the values marked REQUIRED.
# Never commit .env to version control.
# ============================================================

# Database
DATABASE_URL=postgresql+asyncpg://omnivore:omnivore@localhost:5432/omnivore

# Redis
REDIS_URL=redis://localhost:6379/0

# MinIO / S3
# For production, point MINIO_ENDPOINT at your S3 bucket endpoint and set MINIO_SECURE=true.
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=omnivore
MINIO_SECRET_KEY=omnivore123
MINIO_BUCKET=omnivore-raw
MINIO_SECURE=false

# ---- Auth — JWT RS256 keypair (REQUIRED for API auth) ----
# Generate:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out private.pem
#   openssl rsa -pubout -in private.pem -out public.pem
#
# IMPORTANT: wrap the full PEM in double quotes so the .env parser preserves
# the line breaks. Without quotes only the BEGIN header is loaded and JWT
# token exchange (POST /v1/auth/token) will return 500.
#
# JWT_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----
# MIIEvQIBADA...
# -----END PRIVATE KEY-----"
#
# JWT_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----
# MIIBIjANBg...
# -----END PUBLIC KEY-----"
JWT_PRIVATE_KEY_PEM=
JWT_PUBLIC_KEY_PEM=
JWT_ALGORITHM=RS256
JWT_ACCESS_TOKEN_EXPIRE_SECONDS=3600

# Admin bootstrap token (REQUIRED — change before first run)
# Used only for initial tenant/key provisioning via the /v1/admin/* endpoints.
# Treat it like a root password — it is permanently valid and never expires.
# Generate: openssl rand -hex 32
ADMIN_BOOTSTRAP_TOKEN=change-me-before-first-run

# Legacy symmetric key — kept for any internal signing not covered by RS256.
# Change this value before deploying.
SECRET_KEY=change-me-in-production

# ---- Rate limiting (Lua token bucket, per-tenant defaults) ----
RL_CAPACITY=100
RL_REFILL_RATE=10.0
RL_UPLOAD_COST=10
RL_DEFAULT_COST=1

# ---- LLM APIs (optional) ----
# Set ANTHROPIC_API_KEY to enable Claude Haiku document summaries.
# Leave empty to skip the summarization step.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---- Upload and queue limits ----
MAX_UPLOAD_SIZE_BYTES=2147483648
MAX_QUEUE_DEPTH=100
MAX_GPU_QUEUE_DEPTH=20

# ---- OCR ----
# JSON array of EasyOCR language codes applied by default.
# Per-request overrides are supported via ctx.config.
IMAGE_OCR_LANGUAGES=["en"]

# ---- Observability ----
# OTel tracing — disabled by default. Set to true when running with --profile monitoring.
# If enabled without Tempo running, BatchSpanProcessor retries silently but logs will show
# connection warnings. Default: false.
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=omnivore

# Prometheus metrics endpoint (/metrics)
METRICS_ENABLED=true
# If set, Prometheus must send this value as a Bearer token when scraping /metrics.
# Generate: openssl rand -hex 32 > observability/auth_token
# Then copy the token here AND into observability/auth_token so docker compose picks it up.
# Leave empty to disable auth on /metrics (fine for local dev).
METRICS_AUTH_TOKEN=

# ---- App ----
LOG_LEVEL=INFO
ENVIRONMENT=development
