# Database
DATABASE_URL=postgresql+asyncpg://omnivore:omnivore@localhost:5432/omnivore

# Redis
REDIS_URL=redis://localhost:6379/0

# MinIO / S3
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=omnivore
MINIO_SECRET_KEY=omnivore123
MINIO_BUCKET=omnivore-raw
MINIO_SECURE=false

# Auth
SECRET_KEY=change-me-in-production

# LLM APIs (optional)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# App
LOG_LEVEL=INFO
ENVIRONMENT=development
MAX_UPLOAD_SIZE_BYTES=2147483648
MAX_QUEUE_DEPTH=100
MAX_GPU_QUEUE_DEPTH=20
IMAGE_OCR_LANGUAGES=["en"]

# Observability (OTel tracing — opt-in with --profile monitoring)
# IMPORTANT: Use http://tempo:4318 (not localhost) when running inside Docker Compose.
# Set OTEL_ENABLED=true and configure this when running with --profile monitoring.
# OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4318
# OTEL_SERVICE_NAME=omnivore
