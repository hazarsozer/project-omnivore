{
  "title": "Cost Overview",
  "uid": "omnivore-cost",
  "schemaVersion": 38,
  "version": 1,
  "tags": ["omnivore"],
  "time": {"from": "now-24h", "to": "now"},
  "timepicker": {},
  "timezone": "browser",
  "refresh": "1m",
  "panels": [
    {
      "id": 1,
      "title": "Storage Ingested (MB/hr)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "omnivore-prometheus"},
      "targets": [
        {
          "expr": "rate(omnivore_storage_bytes_total[5m]) * 3600 / 1048576",
          "legendFormat": "{{tenant_id}} / {{mime_type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "decmbytes",
          "displayName": "MB/hr"
        }
      }
    },
    {
      "id": 2,
      "title": "Cumulative Storage per Tenant (MB)",
      "type": "barchart",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "omnivore-prometheus"},
      "targets": [
        {
          "expr": "sum by (tenant_id) (omnivore_storage_bytes_total) / 1048576",
          "legendFormat": "{{tenant_id}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "decmbytes"
        }
      }
    },
    {
      "id": 3,
      "title": "Documents Processed per Tenant (last 24h)",
      "type": "barchart",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "datasource": {"type": "prometheus", "uid": "omnivore-prometheus"},
      "targets": [
        {
          "expr": "sum by (tenant_id) (increase(omnivore_documents_total{status=\"indexed\"}[24h]))",
          "legendFormat": "{{tenant_id}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    },
    {
      "id": 4,
      "title": "Ingest Duration p95 by Handler (s)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "datasource": {"type": "prometheus", "uid": "omnivore-prometheus"},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(omnivore_ingest_duration_seconds_bucket[5m]))",
          "legendFormat": "p95 {{handler}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "id": 5,
      "title": "Top Tenants by Chunk Volume",
      "type": "barchart",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 16},
      "datasource": {"type": "prometheus", "uid": "omnivore-prometheus"},
      "targets": [
        {
          "expr": "topk(10, sum by (tenant_id) (omnivore_chunks_total))",
          "legendFormat": "{{tenant_id}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    }
  ]
}
