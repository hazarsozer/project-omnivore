NEXT_PUBLIC_API_URL=http://localhost:8000
# SECURITY WARNING: NEXT_PUBLIC_* vars are inlined into the client JS bundle and
# shipped to EVERY browser. Setting NEXT_PUBLIC_API_KEY exposes the key publicly
# AND bypasses the login gate (auth.ts treats a present env key as authenticated).
# Use for LOCAL / single-user / trusted environments ONLY. For public deployments,
# leave this empty and use the login flow (/login exchanges an API key for a
# short-lived JWT).
#
# API key with at least documents:read, search:read, entities:read, documents:write, handlers:read scopes.
# Create via: POST /v1/admin/tenants then POST /v1/admin/api-keys
NEXT_PUBLIC_API_KEY=
